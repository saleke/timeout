  "aliases": {
    "surface-raised": "surfaceRaised",
    "text-primary": "onSurface",
    "text-secondary": "onSurfaceVariant",
    "accent": "primary",
    "state-planned": "primary",
    "state-restricted": "primaryContainer",
    "state-attention": "warning",
    "state-error": "error"
  },
  "typography": {
    "family": "system-sans",
    "heroTime": { "sizeSp": 40, "lineHeightSp": 48, "tabularNumerals": true },
    "screenTitle": { "sizeSp": 28, "lineHeightSp": 36 },
    "sectionTitle": { "sizeSp": 20, "lineHeightSp": 28 },
    "body": { "sizeSp": 16, "lineHeightSp": 24 },
    "supporting": { "sizeSp": 14, "lineHeightSp": 20 },
    "buttonLabel": { "sizeSp": 14, "lineHeightSp": 20 }
  },
  "spacingDp": [4, 8, 12, 16, 24, 32],
  "shapeDp": { "card": 20, "button": 16, "sheet": 28 },
  "motion": {
    "pressMs": 120,
    "feedbackMs": 160,
    "contentChangeMs": 200,
    "sheetEnterMs": 240,
    "sheetExitMs": 180,
    "screenChangeMs": 240,
    "screenPopMs": 200,
    "tabExitMs": 60,
    "tabEnterMs": 100,
    "tabEnterDelayMs": 60,
    "pressScale": 0.97,
    "customEaseOut": [0.23, 1, 0.32, 1],
    "customEaseInOut": [0.77, 0, 0.175, 1],
    "nativeComponentsUsePlatformMotion": true,
    "systemAnimationsOffIsImmediate": true
  },
  "components": {
    "choiceGroup": { "minimumHeightDp": 52, "minimumWidthDp": 88, "gapDp": 8, "contentPaddingDp": 8, "iconWidthDp": 18, "iconGapDp": 8, "cornerRadiusDp": 16 },
    "primaryButton": { "container": "primary", "content": "onPrimary", "minimumHeightDp": 56 },
    "outlinedButton": { "container": "surface", "content": "primary", "outline": "outline", "minimumHeightDp": 48 },
    "iconButton": { "content": "onSurface", "minimumTargetDp": 48 },
    "appRow": { "content": "onSurface", "secondaryContent": "onSurfaceVariant", "minimumHeightDp": 64, "iconSizeDp": 40 },
    "restrictionStatus": { "container": "primaryContainer", "content": "onPrimaryContainer" },
    "configurationFailure": { "container": "errorContainer", "content": "onErrorContainer" },
    "permissionAttention": { "container": "warningContainer", "content": "onWarningContainer" }
  },
  "contrastPairs": [
    { "foreground": "onSurface", "backgrounds": ["background", "surface", "surfaceRaised"], "minimum": 4.5 },
    { "foreground": "onSurfaceVariant", "backgrounds": ["background", "surface", "surfaceRaised"], "minimum": 4.5 },
    { "foreground": "primary", "backgrounds": ["background", "surface", "surfaceRaised"], "minimum": 4.5 },
    { "foreground": "onPrimary", "backgrounds": ["primary"], "minimum": 4.5 },
    { "foreground": "onPrimaryContainer", "backgrounds": ["primaryContainer"], "minimum": 4.5 },
    { "foreground": "primary", "backgrounds": ["primaryContainer"], "minimum": 4.5 },
    { "foreground": "onSurface", "backgrounds": ["primaryContainer"], "minimum": 4.5 },
    { "foreground": "onSurfaceVariant", "backgrounds": ["primaryContainer"], "minimum": 4.5 },
    { "foreground": "inverseOnSurface", "backgrounds": ["inverseSurface"], "minimum": 4.5 },
    { "foreground": "inversePrimary", "backgrounds": ["inverseSurface"], "minimum": 4.5 },
    { "foreground": "outline", "backgrounds": ["background", "surface", "surfaceRaised"], "minimum": 3.0 },
    { "foreground": "outline", "backgrounds": ["primaryContainer"], "minimum": 3.0 },
    { "foreground": "error", "backgrounds": ["background", "surface", "surfaceRaised"], "minimum": 4.5 },
    { "foreground": "onErrorContainer", "backgrounds": ["errorContainer"], "minimum": 4.5 },
    { "foreground": "warning", "backgrounds": ["background", "surface", "surfaceRaised"], "minimum": 4.5 },
    { "foreground": "onWarningContainer", "backgrounds": ["warningContainer"], "minimum": 4.5 },
    { "foreground": "success", "backgrounds": ["background", "surface", "surfaceRaised"], "minimum": 4.5 },
    { "foreground": "onSuccessContainer", "backgrounds": ["successContainer"], "minimum": 4.5 }
  ]
}
