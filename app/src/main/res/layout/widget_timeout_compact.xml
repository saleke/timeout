<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/widget_background"
    android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:text="@string/app_name" android:textColor="@color/widget_on_surface"
        android:textSize="15sp" android:textStyle="bold" android:maxLines="1"
        android:drawableStart="@drawable/ic_brand_mark" android:drawableTint="@color/widget_primary" android:drawablePadding="8dp" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:text="@string/widget_ready" android:textColor="@color/widget_secondary"
        android:textSize="13sp" android:maxLines="2" />
    <TextView android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center" android:background="@drawable/widget_action_background" android:text="@string/widget_pause_app"
        android:textColor="@color/widget_on_primary" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
